@model List<ListarItensListaViewModel>

@{
    ViewBag.Titulo = "Itens da Lista";

    string listaCompraId = Model.Count > 0
        ? Model.First().ListaCompraId
        : Context.Request.Query["listaCompraId"].ToString();

    string nomeLista = Model.Count > 0
        ? Model.First().NomeListaCompra
        : "Lista de Compras";

    decimal valorTotal = Model.Sum(i => i.ValorTotal);
}

<div class="content-panel p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1">@nomeLista</h2>
            <p class="text-secondary mb-0">Itens cadastrados nesta lista.</p>
        </div>

        <a class="btn btn-primary align-self-start" asp-action="Cadastrar" asp-route-listaCompraId="@listaCompraId">
            Adicionar item
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum item adicionado nesta lista.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-3">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Quantidade</th>
                        <th>Preço aproximado</th>
                        <th>Valor total</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (ListarItensListaViewModel item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.NomeProduto</td>
                            <td>
                                <span class="badge text-bg-light border">@item.NomeCategoria</span>
                            </td>
                            <td>@item.Quantidade</td>
                            <td>@item.PrecoAproximado.ToString("C")</td>
                            <td>@item.ValorTotal.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@item.Id">
                                    Remover
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Total estimado</th>
                        <th>@valorTotal.ToString("C")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <a class="btn btn-outline-secondary" asp-controller="ListaCompra" asp-action="Listar">
        Voltar para listas
    </a>
</div>