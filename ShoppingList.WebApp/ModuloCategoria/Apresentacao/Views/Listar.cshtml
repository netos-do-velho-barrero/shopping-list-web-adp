@using ListaDeComprasWeb.WebApp.ModuloCategoria.Dominio
@using ShoppingList.WebApp.ModuloCategoria.Apresentacao

@model List<ListarCategoriaViewModel>

@{
    ViewBag.Titulo = "Categorias";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>
        <h1 class="h3 mb-1">Categorias</h1>

        <p class="text-secondary mb-0">
            Gerencie as categorias dos seus produtos.
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Cadastrar">
        Nova categoria
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <h2 class="h5 mb-2">
                    Nenhuma categoria cadastrada
                </h2>

                <p class="text-secondary mb-4">
                    Cadastre sua primeira categoria.
                </p>

                <a class="btn btn-primary" asp-action="Cadastrar">
                    Cadastrar categoria
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Cor</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (ListarCategoriaViewModel categoria in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @categoria.Nome
                                    </div>

                                    <small class="text-secondary">
                                        Código: @categoria.Id
                                    </small>
                                </td>

                                <td>
                                    @categoria.Cor
                                </td>

                                <td class="text-end">

                                    <div class="btn-group btn-group-sm" role="group">

                                        <a class="btn btn-outline-primary"
                                           asp-action="Editar"
                                           asp-route-id="@categoria.Id">
                                            Editar
                                        </a>

                                        <a class="btn btn-outline-danger"
                                           asp-action="Excluir"
                                           asp-route-id="@categoria.Id">
                                            Excluir
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>