@using ListaDeComprasWeb.WebApp.ModuloCategoria.Dominio
@using ShoppingList.WebApp.ModuloCategoria.Apresentacao


@model CadastrarCategoriaViewModel

@{
    ViewBag.Titulo = "CadastrarCategoria";
}

<div class="content-panel p-4">
    <h2 class="h4 mb-1">Nova categoria</h2>
    <p class="text-secondary mb-4">
        Informe um nome para a categoria.
    </p>
    <form asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3">
        </div>
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">
                Nome da categoria
            </label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Categoria de Limpeza" />
            <span asp-validation-for="Nome" class="text-danger small">
            </span>
        </div>
        <div class="mb-3">
            <label asp-for="Cor" class="form-label">
                Cor da categoria
            </label>
            <select asp-for="Cor" asp-items="Html.GetEnumSelectList<CorCategoria>()" class="form-select">
                <option value="">
                    Selecione uma cor
                </option>
            </select>
            <span asp-validation-for="Cor" class="text-danger small">
            </span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Cadastrar
            </button>
        </div>
    </form>
</div>