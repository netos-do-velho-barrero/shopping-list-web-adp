@using ListaDeComprasWeb.WebApp.ModuloCategoria.Dominio
@using ShoppingList.WebApp.ModuloCategoria.Apresentacao

@model EditarCategoriaViewModel

@{
    ViewBag.Titulo = "Editar Categoria";
}

<div class="content-panel p-4">

    <h2 class="h4 mb-1">Editar categoria</h2>

    <p class="text-secondary mb-4">
        Atualize o nome ou a cor da categoria.
    </p>

    <form asp-action="Editar" method="post">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Nome" class="form-label">
                Nome da categoria
            </label>

            <input asp-for="Nome"
                   class="form-control" />

            <span asp-validation-for="Nome"
                  class="text-danger small">
            </span>

        </div>

        <div class="mb-4">

            <label asp-for="Cor" class="form-label">
                Cor da categoria
            </label>

            <select asp-for="Cor"
                    asp-items="Html.GetEnumSelectList<CorCategoria>()"
                    class="form-select">
            </select>

            <span asp-validation-for="Cor"
                  class="text-danger small">
            </span>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Salvar alterações
            </button>

            <a class="btn btn-outline-secondary"
               asp-action="Listar">
                Voltar
            </a>

        </div>

    </form>

</div>