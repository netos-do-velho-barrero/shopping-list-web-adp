
@using ListaDeComprasWeb.WebApp.ModuloProduto.Dominio
@using ShoppingList.WebApp.ModuloProduto.Apresentacao

@model CadastrarProdutoViewModel

@{
    ViewBag.Titulo = "Cadastrar Produto";
}

<div class="content-panel p-4">
    <h2 class="h4 mb-1">Novo produto</h2>
    <p class="text-secondary mb-4">
        Informe os dados do produto para adicioná-lo ao catálogo.
    </p>

    <form asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do produto</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Sabão em Pó" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">Categoria</label>
            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                <option value="">Selecione uma categoria</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnidadeMedida" class="form-label">Unidade de Medida</label>
            <select asp-for="UnidadeMedida" asp-items="Html.GetEnumSelectList<UnidadeMedida>()" class="form-select">
                <option value="">Selecione a unidade</option>
            </select>
            <span asp-validation-for="UnidadeMedida" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PrecoAproximado" class="form-label">Preço Aproximado</label>
            <input asp-for="PrecoAproximado" type="number" step="0.01" class="form-control" placeholder="0,00" />
            <span asp-validation-for="PrecoAproximado" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Cadastrar</button>
            <a asp-action="Listar" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>