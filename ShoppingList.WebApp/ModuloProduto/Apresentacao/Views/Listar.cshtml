@using ShoppingList.WebApp.ModuloProduto.Apresentacao

@model List<ListarProdutoViewModel>

@{
    ViewBag.Titulo = "Produtos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>
        <h1 class="h3 mb-1">Produtos</h1>
        <p class="text-secondary mb-0">
            Gerencie os produtos cadastrados para utilizar em suas listas de compras.
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Cadastrar">
        Novo produto
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <h2 class="h5 mb-2">
                    Nenhum produto cadastrado
                </h2>

                <p class="text-secondary mb-4">
                    Cadastre seu primeiro produto para começar.
                </p>

                <a class="btn btn-primary" asp-action="Cadastrar">
                    Cadastrar produto
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Preço Aproximado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (ListarProdutoViewModel produto in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @produto.Nome
                                    </div>
                                    <small class="text-secondary">
                                        Código: @produto.Id
                                    </small>
                                </td>

                                <td>
                                    <span class="badge text-bg-light border">
                                        @produto.CategoriaNome
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @produto.PrecoAproximado.ToString("C")
                                </td>

                                <td class="text-end">

                                    <div class="btn-group btn-group-sm" role="group">

                                        <a class="btn btn-outline-primary"
                                           asp-action="Editar"
                                           asp-route-id="@produto.Id">
                                            Editar
                                        </a>

                                        <a class="btn btn-outline-danger"
                                           asp-action="Excluir"
                                           asp-route-id="@produto.Id">
                                            Excluir
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>