@using ShoppingList.WebApp.ModuloProduto.Apresentacao

@model ExcluirProdutoViewModel

@{
    ViewBag.Titulo = "Excluir Produto";
}

<div class="content-panel p-4">

    <div class="alert alert-warning">
        Tem certeza que deseja excluir esta produto?
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Nome</span>
                <div class="fw-semibold">@Model.Nome</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Categoria</span>
                <div class="fw-semibold">@Model.CategoriaNome</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Unidade de Medida</span>
                <div class="fw-semibold">@Model.UnidadeMedida</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <span class="text-secondary small">Preço Aproximado</span>
                <div class="fw-semibold">@Model.PrecoAproximado.ToString("C")</div>
            </div>
        </div>

    </div>

    <form asp-action="Excluir" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                Confirmar exclusão
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                Cancelar
            </a>
        </div>

    </form>

</div>