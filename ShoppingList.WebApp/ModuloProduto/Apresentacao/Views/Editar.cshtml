@using ListaDeComprasWeb.WebApp.Compartilhado.Dominio
@using ListaDeComprasWeb.WebApp.ModuloProduto.Dominio
@using ShoppingList.WebApp.ModuloProduto.Apresentacao

@model EditarProdutoViewModel

@{
    ViewBag.Titulo = "Editar Produto";
}

<div class="content-panel p-4">

    <h2 class="h4 mb-1">Editar produto</h2>

    <p class="text-secondary mb-4">
        Atualize os dados e as informações do produto selecionado.
    </p>

    <form asp-action="Editar" method="post">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do produto</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">Categoria</label>
            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                <option value="">Selecione uma categoria</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnidadeMedida" class="form-label">Unidade de Medida</label>
            <select asp-for="UnidadeMedida" asp-items="Html.GetEnumSelectList<UnidadeMedida>()" class="form-select">
            </select>
            <span asp-validation-for="UnidadeMedida" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="PrecoAproximado" class="form-label">Preço Aproximado</label>
            <input asp-for="PrecoAproximado" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="PrecoAproximado" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Salvar alterações
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                Voltar
            </a>
        </div>

    </form>

</div>