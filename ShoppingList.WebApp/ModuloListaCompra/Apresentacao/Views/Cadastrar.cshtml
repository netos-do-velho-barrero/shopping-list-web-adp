@model CadastrarListaCompraViewModel

@{
    ViewBag.Titulo = "Cadastrar Lista de Compras";
}

<form asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome da lista</label>
        <input asp-for="Nome" class="form-control" placeholder="Ex: Compras da semana" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Cadastrar
        </button>

        <a class="btn btn-outline-secondary" asp-action="Listar">
            Voltar
        </a>
    </div>
</form>