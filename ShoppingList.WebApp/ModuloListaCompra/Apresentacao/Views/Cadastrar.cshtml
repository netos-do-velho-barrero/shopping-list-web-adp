@model CadastrarListaCompraViewModel

@{
    ViewBag.Titulo = "Cadastrar Lista";
}

<div class="content-panel p-4">
    <h2 class="h4 mb-1">Nova lista de compras</h2>
    <p class="text-secondary mb-4">Informe um nome para começar a organizar os itens.</p>

    <form asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome da lista</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Compras da semana" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Cadastrar
            </button>

            <a class="btn btn-outline-secondary" asp-action="Listar">
                Voltar
            </a>
        </div>
    </form>
</div>