@model ExcluirListaCompraViewModel

@{
    ViewBag.Titulo = "Excluir Lista de Compras";
}

<div class="alert alert-warning">
    Tem certeza que deseja excluir esta lista de compras?
</div>

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">Data de criação</dt>
    <dd class="col-sm-9">@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Total de itens</dt>
    <dd class="col-sm-9">@Model.TotalItens</dd>

    <dt class="col-sm-3">Total estimado</dt>
    <dd class="col-sm-9">@Model.ValorTotalEstimado.ToString("C")</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">
            Confirmar exclusão
        </button>

        <a class="btn btn-outline-secondary" asp-action="Listar">
            Cancelar
        </a>
    </div>
</form>