@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="row g-4 align-items-stretch">
    <div class="col-lg-7">
        <div class="content-panel h-100 p-4 p-lg-5">
            <span class="badge text-bg-primary mb-3">Organização de compras</span>

            <h2 class="display-6 fw-semibold mb-3">
                Controle suas listas, produtos e categorias em um só lugar.
            </h2>

            <p class="lead text-secondary mb-4">
                Crie listas de compras, adicione itens, acompanhe quantidades e veja o total estimado de cada lista.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary px-4" asp-controller="ListaCompra" asp-action="Listar">
                    Abrir listas
                </a>

                <a class="btn btn-outline-primary px-4" asp-controller="Categoria" asp-action="Listar">
                    Categorias
                </a>

                <a class="btn btn-outline-primary px-4" asp-controller="Produto" asp-action="Listar">
                    Produtos
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="content-panel h-100 p-4">
            <h3 class="h5 mb-3">Módulos</h3>

            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center"
                   asp-controller="Categoria" asp-action="Listar">
                    <span>
                        <strong>Categorias</strong>
                        <span class="d-block text-secondary small">Agrupe produtos por tipo.</span>
                    </span>
                    <span class="badge text-bg-light border">Abrir</span>
                </a>

                <a class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center"
                   asp-controller="Produto" asp-action="Listar">
                    <span>
                        <strong>Produtos</strong>
                        <span class="d-block text-secondary small">Cadastre preços e unidades.</span>
                    </span>
                    <span class="badge text-bg-light border">Abrir</span>
                </a>

                <a class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center"
                   asp-controller="ListaCompra" asp-action="Listar">
                    <span>
                        <strong>Listas</strong>
                        <span class="d-block text-secondary small">Monte e acompanhe suas compras.</span>
                    </span>
                    <span class="badge text-bg-primary">Abrir</span>
                </a>
            </div>
        </div>
    </div>
</div>